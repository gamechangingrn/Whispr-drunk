{
  "name": "willfull",
  "version": "0.1.0",
  "description": "Private, local voice dictation for Windows",
  "author": "Willfull",
  "license": "MIT",
  "type": "module",
  "main": "dist/main/main.cjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "tsc --noEmit && vite build && node scripts/build-main.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "start": "electron .",
    "native": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-native.ps1",
    "setup:speech": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/setup-speech.ps1",
    "setup:editor": "node scripts/setup-editor.mjs",
    "setup:editor-cpu": "node scripts/setup-editor-cpu.mjs",
    "package": "pnpm build && electron-builder --win dir",
    "dist": "pnpm build && node scripts/package.mjs",
    "smoke": "node scripts/smoke.mjs"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "^5.2.8",
    "lucide-react": "^0.577.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sql.js": "^1.14.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/sql.js": "^1.4.9",
    "@vitejs/plugin-react": "^5.1.0",
    "electron": "44.9.2",
    "electron-builder": "26.15.3",
    "esbuild": "^0.27.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.0",
    "vitest": "^4.0.0",
    "playwright": "^1.58.0"
  },
  "build": {
    "appId": "app.willfull.desktop",
    "productName": "Willfull",
    "directories": {"output": "release"},
    "files": ["dist/**/*", "package.json", "node_modules/sql.js/dist/sql-wasm.wasm"],
    "extraResources": [
      {"from": "native/windows/bin", "to": "native", "filter": ["Willfull.Native.exe"]},
      {"from": "workers/speech", "to": "speech", "filter": ["**/*", "!**/__pycache__/**"]},
      {"from": "resources/runtime/python", "to": "runtime/python", "filter": ["**/*", "!**/__pycache__/**", "!**/tests/**", "!**/test/**"]},
      {"from": "resources/models", "to": "models"},
      {"from": "resources/llama", "to": "llama", "filter": ["*.gguf", "bin/**/*"]},
      {"from": "resources/llama-cpu", "to": "llama-cpu", "filter": ["*.gguf", "bin/**/*"]},
      {"from": "THIRD_PARTY_NOTICES.md", "to": "THIRD_PARTY_NOTICES.md"}
    ],
    "asarUnpack": ["**/*.wasm"],
    "win": {"target": [{"target":"nsis","arch":["x64"]},{"target":"zip","arch":["x64"]}], "signAndEditExecutable": false},
    "nsis": {"oneClick": false, "perMachine": false, "allowToChangeInstallationDirectory": true, "createDesktopShortcut": true}
  }
}
